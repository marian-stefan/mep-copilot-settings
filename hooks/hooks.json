{
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "bash": "node ${PLUGIN_ROOT}/hooks/tool-guardian/guard-tool.mjs",
        "powershell": "node ${PLUGIN_ROOT}/hooks/tool-guardian/guard-tool.mjs",
        "env": {
          "GUARD_MODE": "block"
        },
        "timeoutSec": 10
      }
    ]
  }
}
